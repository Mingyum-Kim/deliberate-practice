training_program:
  name: "Ticket-Based Product Immersion Training"
  slug: "ticket-based-product-immersion"
  priority: 1
  status: active
  start_date: 2026-06-01
  end_date: 2026-06-28
  motivation: |
    To build a stronger sense of ownership, curiosity, and focus by understanding
    the users of the product and the impact the product creates in my work.
  goal: |
    Complete 4 weeks of deliberate immersion practice starting June 1st.
    By the end, the habit of asking user-level questions on every ticket should
    feel natural, not forced.
  problem_to_solve: |
    Treating tickets as isolated implementation tasks.
    I want to better understand the user problem, product impact, and operational
    risks behind each ticket, so that I can feel more ownership, ask better
    questions, and become more immersed in my work.
  desired_behavior_change: |
    (leave blank — user can fill in later)
  daily_actions:
    - Draw the overall flow and explain to myself what role my part plays in that flow.
    - Write down how this work may affect users:
        - What user problem can be solved through this work?
        - Are there alternative approaches? What are the pros and cons?
        - What operational gaps or user failure scenarios could this work create?
          Can they be prevented or detected in advance?
    - Think about how to test from the user's perspective and verify impact after deployment:
        - API, DB, logs, dashboards, metrics, test automation
    - Check whether I shared organized questions or findings with a senior developer or manager.
  weekly_actions:
    - Review daily reflection scores and identify patterns
    - Adjust difficulty or scope of next week's daily actions
  scoring_system:
    scale: 1-5
    criteria:
      1: Did nothing or only passive exposure
      2: Partial effort — started but did not complete
      3: Completed the actions but without deep engagement
      4: Fully engaged, produced real output or insight
      5: Exceeded expectations — deep insight, visible contribution, or behavior shift
  daily_reflection:
    ai_role: Guide reflection, score actions based on criteria, suggest tomorrow's concrete plan
    prompt_structure:
      - What did you do today for this training?
      - Which specific actions did you complete?
      - What did you avoid or skip?
      - What was difficult?
      - What did you learn or notice?
      - Score (1-5) with reasoning
      - What is one concrete action for tomorrow?
  weekly_reflection:
    user_role: Lead the reflection — the AI asks questions, you answer
    ai_role: Surface patterns from daily scores, ask guiding questions, do not evaluate
    prompt_structure:
      - Did this training actually help you this week?
      - When did you feel most focused or engaged?
      - What felt uncomfortable or unrealistic?
      - What did you avoid?
      - Was the scoring system useful?
      - Did the training create real behavior change?
      - What should you maintain next week?
      - What should you reduce?
      - What should you make harder?
      - What should you make easier?
  reminders:
    daily:
      enabled: true
      time: "21:00"
      message: "Reflect on today's deliberate practice actions."
    weekly:
      enabled: true
      day: sunday
      time: "10:00"
      message: "Do your weekly training system review."
  review_rules:
    maintain_if: Scoring 3+ consistently for 5+ days
    adjust_if: Scoring below 2 for 3+ consecutive days
    pause_if: No reflections filed for 5+ consecutive days
    complete_if: End date reached (2026-06-28) or completion condition met
  notes: ""
